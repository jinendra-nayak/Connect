# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# local tooling & agent artifacts
.claude/
.playwright-mcp/
.cursor/
.21st/
.mcp.json

# local scratch / reference screenshots
/tmp/

# reference / third-party product photos used for local design testing only.
# Never commit or deploy these; real ConnectCom photos go in public/images/products-final/
/images/*
# ...except openly licensed photos (CC0 / CC BY-SA) and their credits, so provenance is tracked
!/images/free-licensed/
/public/images/products/

# python (scripts/prepare-images.py)
__pycache__/
*.pyc
